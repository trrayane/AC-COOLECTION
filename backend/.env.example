# ── Server ───────────────────────────────────────────────
PORT=4000
# Public base URL of THIS backend (used to build local image URLs)
BASE_URL=http://localhost:4000
# Where the React frontend runs (allowed by CORS)
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ────────────────────────────────
# Create a database first, e.g.:  CREATE DATABASE ac_collection;
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ac_collection
DB_USER=postgres
DB_PASSWORD=postgres

# ── Auth ─────────────────────────────────────────────────
# CHANGE THIS to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
# The single admin account created by the seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Image storage (OPTIONAL) ─────────────────────────────
# Leave these EMPTY to store uploads in the local /uploads folder (dev default).
# Fill them later to switch to Cloudinary — nothing else to change.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── New-order notifications (OPTIONAL) ───────────────────
# Telegram (easiest): create a bot with @BotFather → token; get your chat id
# from @userinfobot. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via Resend (https://resend.com). Leave empty to disable.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=AC Collection <onboarding@resend.dev>
