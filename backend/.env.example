# ── Server ───────────────────────────────────────────────
PORT=4000
# Public base URL of THIS backend (used to build local image URLs)
BASE_URL=http://localhost:4000
# Where the React frontend runs (allowed by CORS)
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ────────────────────────────────
# Create a database first, e.g.:  CREATE DATABASE ac_collection;
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ac_collection
DB_USER=postgres
DB_PASSWORD=postgres

# ── Auth ─────────────────────────────────────────────────
# CHANGE THIS to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
# The single admin account created by the seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Image storage (OPTIONAL) ─────────────────────────────
# Leave these EMPTY to store uploads in the local /uploads folder (dev default).
# Fill them later to switch to Cloudinary — nothing else to change.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── New-order email notifications (OPTIONAL) ─────────────
# Leave empty to disable. To enable with Gmail:
#   1) enable 2-Step Verification on the Gmail account
#   2) create an "App Password" (Google account → Security → App passwords)
#   3) fill below: SMTP_USER = your gmail, SMTP_PASS = the 16-char app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=        # where order alerts are sent (defaults to SMTP_USER)
NOTIFY_FROM=         # "From" address (defaults to SMTP_USER)
